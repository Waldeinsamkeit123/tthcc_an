    ],
    "spectators": [
      "event",
      "run",
      "luminosityBlock",
      "genTtbarId",
      "weight"
    ],
    "weight_branch": "weight",
    "training_classes": [
      {
        "name": "tthbb",
        "label": "ttH(H->bb)",
        "group": "signal",
        "processes": [
          "ttHbb"
        ]
      },
      {
        "name": "tthcc",
        "label": "ttH(H->cc)",
        "group": "signal",
        "processes": [
          "ttHcc"
        ]
      },
      {
        "name": "ttbar",
        "label": "ttbar / tt+bb / tt+ll",
        "group": "background",
        "processes": [
          "ttbar",
          "ttbb",
          "ttll"
        ]
      },
      {
        "name": "qcd",
        "label": "QCD",
        "group": "background",
        "processes": [
          "qcd"
        ]
      }
    ],
    "eval_processes_extra": [
      "ttH_nonbb"
    ],
    "k_folds": 5,
    "random_seed": 42,
    "uproot_step_size": "200 MB",
    "model_name": "xgb_ttHcc_0l_4class_baseline",
    "prepared_inputs": "prepared_inputs.npz",
    "predictions": "predictions.npz",
    "summary": "training_summary.json",
    "feature_importance": "feature_importance.json",
    "model_dir": "models",
    "plot_dir": "plots",
    "flatten_first_branches": [
      "TargetFatJet_pt",
      "TargetFatJet_eta",
      "TargetFatJet_mass",
      "TargetFatJet_msoftdrop",
      "TargetFatJet_HiggsVsQCD",
      "TargetFatJet_BBvsCC",
