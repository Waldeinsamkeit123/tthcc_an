          500,
          600,
          800,
          1000,
          1300,
          1700,
          2200,
          3000
        ]
      }
    ]
  },
  "xgboost": {
    "tree_method": "hist",
    "eval_metric": [
      "merror",
      "mlogloss"
    ],
    "eta": 0.05,
    "max_depth": 4,
    "subsample": 0.8,
