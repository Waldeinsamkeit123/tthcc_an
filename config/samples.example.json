{
  "normalization": {
    "gen_sumw_file": "/path/to/gen_sumws.json",
    "xsec_file": "/path/to/crosssections_run3.json",
    "lumi_fb": 109.08
  },
  "study": {
    # Relative paths are resolved from the repository root.
    # Absolute paths such as /eos/user/... are also supported here.
    "outdir": "outputs/boosted_higgs_tagger_study",
    "tree_name": "Events",
    "targets": ["hcc", "hbb", "higgs"],
    "scores": ["auto"],
    "sig_effs": [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9],
    "pt_min": 200.0,
    "eta_max": 2.4,
    "candidate_strategy": "mass_window_all_jets",
    "msd_window_low": 100.0,
    "msd_window_high": 150.0,
    "weight_branch": "weight",
    "uproot_step_size": "200 MB",
    "score_hist_bins": 2000
  },
  "plot": {
    "title_size": 16.0,
    "label_size": 12.5,
    "tick_size": 10.0,
    "legend_size": 10.0,
    "cms_size": 16.0,
    "dpi": 220
  },
  "samples": [
    {
      "name": "ttHcc",
      "process": "ttHcc",
      "label": "ttH(H->cc)",
      "files": [
        "/path/to/ttHcc/*.root"
      ]
    },
    {
      "name": "ttHbb",
      "process": "ttHbb",
      "label": "ttH(H->bb)",
      "files": [
        "/path/to/ttHbb/*.root"
      ]
    },
    {
      "name": "ttbar",
      "process": "ttbar",
      "label": "ttbar",
      "files": [
        "/path/to/ttbar/*.root"
      ]
    }
  ]
}
